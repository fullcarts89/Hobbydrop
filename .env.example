# --- Twilio (SMS delivery) ---
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
TWILIO_TO_NUMBER=+1xxxxxxxxxx

# --- Persistence (Supabase Postgres) ---
# Project Settings -> Database -> Connection string -> URI (use the pooler URI
# on Railway). The dedup cache + alert history live here so they survive redeploys.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.xxxxxxxx.supabase.co:5432/postgres

# --- EDGAR (required: must include a real contact email) ---
EDGAR_USER_AGENT=YourName your@email.com

# --- Tunable thresholds (optional; defaults shown) ---
ALERT_THRESHOLD=75
MIN_TRADE_VALUE=100000
MAX_MARKET_CAP=2000000000
MIN_REL_PCT=0.25
CHECK_INTERVAL_MIN=15
LOOKBACK_DAYS=1
EDGAR_RATE_LIMIT=8

# Set to true to score and log alerts without sending SMS.
DRY_RUN=false
